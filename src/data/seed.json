  "formulas": [
    {
      "id": "beam-simple-moment",
      "title": "العزم الأقصى في عتبة بسيطة الإسناد",
      "categoryId": "cat-structures",
      "description": "حساب العزم الأقصى لعتبة محمّلة بحمل منتظم على كامل طولها.",
      "coverAssetId": null,
      "galleryAssetIds": [],
      "inputs": [
        { "key": "w", "label": "الحمل الموزع", "unit": "kN/m", "default": 10, "min": 0, "max": null, "hint": "الحمل الموزع بانتظام على طول العتبة" },
        { "key": "L", "label": "طول العتبة", "unit": "m", "default": 5, "min": 0, "max": null, "hint": "المسافة بين ركيزتي العتبة" }
      ],
      "outputs": [
        {
          "key": "M",
          "label": "العزم الأقصى",
          "unit": "kN.m",
          "expression": "w * L^2 / 8",
          "latex": "M = \\frac{w L^2}{8}",
          "decimals": 2
        }
      ],
      "sourceIds": ["src-001"],
      "tags": ["عزوم", "عتبات", "منشآت"],
      "notes": "يُفترض أن مادة العتبة خطية مرنة وأن الركائز حرة الدوران.",
      "status": "published",
      "isSample": true,
      "createdAt": "2026-10-30T10:00:00.000Z",
      "updatedAt": "2026-10-30T10:00:00.000Z"
    },
    {
      "id": "axial-stress",
      "title": "الإجهاد العمودي المحوري",
      "categoryId": "cat-structures",
      "description": "حساب الإجهاد العمودي المؤثر على مقطع مستعرض تحت تأثير قوة محورية.",
      "coverAssetId": null,
      "galleryAssetIds": [],
      "inputs": [
        { "key": "P", "label": "القوة المحورية", "unit": "kN", "default": 150, "min": 0, "max": null, "hint": "القوة العمودية المؤثرة" },
        { "key": "A", "label": "مساحة المقطع", "unit": "cm²", "default": 50, "min": 0.001, "max": null, "hint": "مساحة المقطع المستعرض" }
      ],
      "outputs": [
        {
          "key": "sigma",
          "label": "الإجهاد العمودي",
          "unit": "MPa",
          "expression": "(P * 1000) / (A * 100)",
          "latex": "\\sigma = \\frac{P}{A}",
          "decimals": 2
        }
      ],
      "sourceIds": ["src-001"],
      "tags": ["إجهاد", "ميكانيكا المواد"],
      "notes": "تمت مراعاة تحويل الوحدات: 1 kN = 1000 N و 1 cm² = 100 mm² للحصول على الناتج بوحدة MPa (N/mm²).",
      "status": "published",
      "isSample": true,
      "createdAt": "2026-10-30T10:00:00.000Z",
      "updatedAt": "2026-10-30T10:00:00.000Z"
    },
    {
      "id": "slab-concrete-volume",
      "title": "حجم ووزن الخرسانة لبلاطة سقف",
      "categoryId": "cat-concrete",
      "description": "حساب الحجم الهندسي للبلاطة والوزن الذاتي التقريبي باعتماد كثافة الخرسانة المسلحة.",
      "coverAssetId": null,
      "galleryAssetIds": [],
      "inputs": [
        { "key": "L", "label": "طول البلاطة", "unit": "m", "default": 6, "min": 0, "max": null, "hint": "البعد في الاتجاه الأول" },
        { "key": "B", "label": "عرض البلاطة", "unit": "m", "default": 4, "min": 0, "max": null, "hint": "البعد في الاتجاه الثاني" },
        { "key": "t", "label": "سماكة البلاطة", "unit": "m", "default": 0.2, "min": 0.05, "max": null, "hint": "سماكة الصب الخرساني" },
        { "key": "density", "label": "كثافة الخرسانة", "unit": "kN/m³", "default": 25, "min": 15, "max": 35, "hint": "الكثافة الحجمية (المعتادة 25 kN/m³)" }
      ],
      "outputs": [
        {
          "key": "Area",
          "label": "مساحة المسطح",
          "unit": "m²",
          "expression": "L * B",
          "latex": "A = L \\times B",
          "decimals": 2
        },
        {
          "key": "Volume",
          "label": "حجم الخرسانة",
          "unit": "m³",
          "expression": "Area * t",
          "latex": "V = A \\times t",
          "decimals": 2
        },
        {
          "key": "Weight",
          "label": "الوزن الإجمالي",
          "unit": "kN",
          "expression": "Volume * density",
          "latex": "W = V \\times \\gamma",
          "decimals": 2
        }
      ],
      "sourceIds": [],
      "tags": ["خرسانة", "كميات", "أوزان"],
      "notes": "هذه المعادلة استرشادية لحساب الكميات والأوزان الذاتية.",
      "status": "published",
      "isSample": true,
      "createdAt": "2026-10-30T10:00:00.000Z",
      "updatedAt": "2026-10-30T10:00:00.000Z"
    }
  ],
  "constants": [
    {
      "key": "g",
