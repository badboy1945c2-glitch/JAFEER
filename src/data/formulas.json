    "outputs": [
      {
        "key": "M",
        "label": "العزم الأقصى",
        "unit": "kN.m",
        "expression": "w * L^2 / 8",
        "latex": "M = \\frac{w L^2}{8}",
        "decimals": 2
      }
    ],
    "sourceIds": ["src-001"],
    "notes": "يُفترض أن المادة خطية مرنة وأن الحمل منتظم.",
